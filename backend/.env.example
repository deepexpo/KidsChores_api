# Environment — copy to .env and fill in real values
DATABASE_URL=postgresql+asyncpg://kidschores:kidschores_dev@localhost:5432/kidschores
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30

# Apple Sign In
APPLE_BUNDLE_ID=com.klsingh.KidsChores
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_KEY_ID=YOUR_KEY_ID
# Path to .p8 file downloaded from Apple Developer portal
APPLE_PRIVATE_KEY_PATH=/secrets/AuthKey.p8

# APNs (push notifications) — token-based Auth Key (.p8), not a certificate.
# Leave APNS_TEAM_ID/APNS_KEY_ID/APNS_PRIVATE_KEY unset to run with push
# notifications logged instead of sent (see app/services/push.py).
APNS_BUNDLE_ID=com.klsingh.KidsChores
APNS_ENV=sandbox   # sandbox for Xcode debug builds; production only for TestFlight/App Store builds
APNS_TEAM_ID=
APNS_KEY_ID=
# Full .p8 file content (not a path) — paste with the BEGIN/END PRIVATE KEY lines
APNS_PRIVATE_KEY=

# App settings
APP_ENV=development
APP_DEBUG=true
ALLOWED_ORIGINS=["http://localhost:3000"]
